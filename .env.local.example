# Copy this file to .env.local and fill in your own values.
# .env.local is already git-ignored and is read automatically by Next.js.

# --- MongoDB ---
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/nri-realestate
#
# MongoDB Atlas (recommended for production):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/nri-realestate?retryWrites=true&w=majority

# --- Optional: protects GET /api/leads for viewing submissions ---
ADMIN_API_KEY=choose-a-long-random-secret

# --- SMTP (lead notification email) ---
# Every form submission (popup + contact page) sends a styled lead-summary
# email to MAIL_TO using these settings. Leave any of these blank to skip
# emailing (the form still saves to MongoDB / syncs to the CRM).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.in
SMTP_PASS=your-smtp-password
MAIL_FROM=noreply@yourdomain.in
# Comma-separated list of recipients
MAIL_TO=you@example.com,sales@example.com
MAIL_SUBJECT=New Lead from Website
BUILDER_NAME=NM NRI Homes

# --- CRM sync ---
# Every form submission is also POSTed as JSON ({ Name, Email, "Mobile no",
# Requirement, "Page URL" }) to this endpoint. Leave blank to skip CRM sync.
CRM_API_URL=https://your-crm.example.com/api/wordpress/leads

# --- Site URL (used in emails / CRM payload as a fallback Page URL) ---
SITE_URL=https://www.homesfornri.in
